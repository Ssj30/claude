{%- comment -%} Product page: trust badges and payment logos. All options are right here in the theme editor. {%- endcomment -%}
<div class="tk-trust" style="--tk-icon: {{ block.settings.icon_size }}px;">
  <div class="tk-trust__grid">
    {%- for i in (1..6) -%}
      {%- assign tk_text_key = 'badge_' | append: i | append: '_text' -%}
      {%- assign tk_icon_key = 'badge_' | append: i | append: '_icon' -%}
      {%- assign tk_text = block.settings[tk_text_key] -%}
      {%- if tk_text != blank -%}
        <div class="tk-trust__item">
          {%- render 'tk-icon', name: block.settings[tk_icon_key] -%}
          <span>{{ tk_text | escape }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if block.settings.show_payments and shop.enabled_payment_types.size > 0 -%}
    {%- if block.settings.payments_heading != blank -%}<p class="tk-trust__heading">{{ block.settings.payments_heading | escape }}</p>{%- endif -%}
    <div class="tk-trust__pay">
      {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}
    </div>
  {%- endif -%}
</div>

