# Copy to .env and fill in. See README.md for how to obtain each value.

# --- Google (Gmail search + Drive uploads + Sheets ledger) ---
GOOGLE_CREDENTIALS_PATH=credentials/google_credentials.json
GOOGLE_TOKEN_PATH=credentials/google_token.json
DRIVE_FOLDER_ID=
SHEET_ID=
SHEET_TAB_LEDGER=Invoices
SHEET_TAB_DUPLICATES=Duplicates

# --- Microsoft / Outlook (Azure AD app registration) ---
MS_TENANT_ID=
MS_CLIENT_ID=
# Leave blank to use the interactive device-code flow instead of app-only auth.
MS_CLIENT_SECRET=
MS_TOKEN_CACHE_PATH=credentials/ms_token_cache.json
OUTLOOK_MAILBOX=me

# --- Search behaviour ---
LOOKBACK_DAYS_FIRST_RUN=90
INVOICE_KEYWORDS=invoice,receipt,bill,statement,payment confirmation
ATTACHMENT_EXTENSIONS=.pdf,.png,.jpg,.jpeg

# --- Misc ---
STATE_PATH=state/sync_state.json
DRY_RUN=false
